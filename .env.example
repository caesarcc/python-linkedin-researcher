# Configuração Local — LinkedIn Researcher & Career Assistant
# ATENÇÃO: Nunca armazene senhas, cookies ou tokens de autenticação neste arquivo.
# Copie este arquivo para .env para customizar caminhos e parâmetros locais.

# Diretório dedicado para o perfil persistente do navegador (ignorado pelo Git)
LINKEDIN_USER_DATA_DIR=.playwright-profile

# Canal do navegador Chromium ("chrome", "msedge" ou vazio para Chromium embutido)
LINKEDIN_BROWSER_CHANNEL=chrome

# Modo de execução do navegador (false recomendado para login manual e uso assistido)
LINKEDIN_HEADLESS=false

# Timeouts padrão (em milissegundos)
LINKEDIN_DEFAULT_TIMEOUT_MS=30000
LINKEDIN_NAVIGATION_TIMEOUT_MS=45000

# Controle de frequência entre navegações (em segundos) para uso pontual e respeitoso
LINKEDIN_MIN_ACTION_DELAY_SEC=3.0
LINKEDIN_MAX_ACTION_DELAY_SEC=7.0

# Caminhos de dados, perfil do candidato, currículo, saída e logs
LINKEDIN_DATA_DIR=data
LINKEDIN_CANDIDATE_PROFILE_PATH=data/perfil_candidato.json
LINKEDIN_CURRICULUM_PATH=curriculum/curriculo.pdf
LINKEDIN_OUTPUT_DIR=output
LINKEDIN_LOGS_DIR=logs
LINKEDIN_LOG_LEVEL=INFO

# Integração com Gemini API (google-genai) com controle de carga (max 5 chamadas/execução)
# Gere sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_CALLS_PER_RUN=5
